													{
														"activity": "LKP_Source_Count",
														"dependencyConditions": [
															"Succeeded"
														]
													}
												],
												"policy": {
													"timeout": "0.12:00:00",
													"retry": 0,
													"retryIntervalInSeconds": 30,
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"source": {
														"type": "SqlServerSource",
														"sqlReaderQuery": {
															"value": "@concat(\n'SELECT COUNT(*) AS CNT FROM ',\nitem().TARGET_SCHEMA,\n'.',\nitem().TARGET_TABLE\n)",
															"type": "Expression"
														},
														"queryTimeout": "02:00:00",
														"partitionOption": "None"
													},
													"dataset": {
														"referenceName": "SqlServerTable2_dynamic",
														"type": "DatasetReference",
														"parameters": {
															"pSchema": "@item().TARGET_SCHEMA",
															"pTable": "@item().TARGET_TABLE"
														}
													}
												}
											},
											{
												"name": "SP_Log_Count_Result",
												"type": "SqlServerStoredProcedure",
												"dependsOn": [
													{
														"activity": "LKP_Target_Count",
														"dependencyConditions": [
															"Succeeded"
														]
													}
												],
												"policy": {
													"timeout": "0.12:00:00",
													"retry": 0,
													"retryIntervalInSeconds": 30,
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"storedProcedureName": "[[dbo].[SP_LOG_VALIDATION_RESULT]",
													"storedProcedureParameters": {
														"SOURCE_COUNT": {
															"value": {
																"value": "@activity('LKP_Source_Count').output.firstRow.CNT",
																"type": "Expression"
															},
															"type": "Int32"
														},
														"STATUS": {
															"value": {
																"value": "@if(\nequals(\nactivity('LKP_Source_Count').output.firstRow.CNT,\nactivity('LKP_Target_Count').output.firstRow.CNT\n),\n'PASS',\n'FAIL'\n)",
																"type": "Expression"
															},
															"type": "String"
														},
														"TARGET_COUNT": {
															"value": {
																"value": "@activity('LKP_Target_Count').output.firstRow.CNT",
																"type": "Expression"
															},
															"type": "Int32"
														},
														"TC_ID": {
															"value": {
																"value": "@item().TC_ID",
																"type": "Expression"
															},
															"type": "String"
														},
														"VALIDATION_TYPE": {
															"value": {
																"value": "@item().VALIDATION_TYPE",
																"type": "Expression"
															},
															"type": "String"
														}
													}
												},
												"linkedServiceName": {
													"referenceName": "SqlServer1_Target",
													"type": "LinkedServiceReference"
												}
											}
										]
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"p_TC_ID": {
						"type": "string",
						"defaultValue": "ALL"
					}
				},
				"annotations": [],
				"lastPublishTime": "2026-06-26T13:27:06Z"
			},
			"dependsOn": []
		},
