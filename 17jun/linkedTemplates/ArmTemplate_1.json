													"source": {
														"type": "OracleSource",
														"oracleReaderQuery": {
															"value": "@concat(\n'SELECT COUNT(*) AS CNT FROM ',\nitem().SOURCE_SCHEMA,\n'.',\nitem().SOURCE_TABLE\n)",
															"type": "Expression"
														},
														"partitionOption": "None",
														"numberPrecision": 38,
														"numberScale": 18,
														"queryTimeout": "02:00:00"
													},
													"dataset": {
														"referenceName": "OracleTable1_dynamic",
