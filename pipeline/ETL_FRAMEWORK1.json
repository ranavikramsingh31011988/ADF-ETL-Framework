{
	"name": "ETL_FRAMEWORK1",
	"properties": {
		"activities": [
			{
				"name": "Lookup_ETL_config",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": {
							"value": "SELECT *\nFROM ETL_CONFIG\nWHERE IS_ACTIVE = 'Y'\nAND (\n      '@{pipeline().parameters.p_TC_ID}' = 'ALL'\n      OR TC_ID = '@{pipeline().parameters.p_TC_ID}'\n);",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "SqlServerTable1",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ForEach1_Validate_Tables",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Lookup_ETL_config",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Lookup_ETL_config').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "IF_count_Check",
							"type": "IfCondition",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@contains(item().VALIDATION_TYPES,'COUNT')",
									"type": "Expression"
								},
								"ifTrueActivities": [
									{
										"name": "LKP_Source_Count",
										"type": "Lookup",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "OracleSource",
												"oracleReaderQuery": {
													"value": "@concat(\n'SELECT COUNT(*) AS CNT FROM ',\nitem().SOURCE_SCHEMA,\n'.',\nitem().SOURCE_TABLE\n)",
													"type": "Expression"
												},
												"partitionOption": "None",
												"numberPrecision": 38,
												"numberScale": 18,
												"queryTimeout": "02:00:00"
											},
											"dataset": {
												"referenceName": "OracleTable1_dynamic",
												"type": "DatasetReference",
												"parameters": {
													"pSchema": "@item().SOURCE_SCHEMA",
													"pTable": "@item().SOURCE_TABLE"
												}
											}
										}
									},
									{
										"name": "LKP_Target_Count",
										"type": "Lookup",
										"dependsOn": [
											{
												"activity": "LKP_Source_Count",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "SqlServerSource",
												"sqlReaderQuery": {
													"value": "@concat(\n'SELECT COUNT(*) AS CNT FROM ',\nitem().TARGET_SCHEMA,\n'.',\nitem().TARGET_TABLE\n)",
													"type": "Expression"
												},
												"queryTimeout": "02:00:00",
												"partitionOption": "None"
											},
											"dataset": {
												"referenceName": "SqlServerTable2_dynamic",
												"type": "DatasetReference",
												"parameters": {
													"pSchema": "@item().TARGET_SCHEMA",
													"pTable": "@item().TARGET_TABLE"
												}
											}
										}
									},
									{
										"name": "SP_Log_Count_Result",
										"type": "SqlServerStoredProcedure",
										"dependsOn": [
											{
												"activity": "LKP_Target_Count",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"storedProcedureName": "[dbo].[SP_LOG_VALIDATION_RESULT]",
											"storedProcedureParameters": {
												"SOURCE_COUNT": {
													"value": {
														"value": "@activity('LKP_Source_Count').output.firstRow.CNT",
														"type": "Expression"
													},
													"type": "Int32"
												},
												"STATUS": {
													"value": {
														"value": "@if(\nequals(\nactivity('LKP_Source_Count').output.firstRow.CNT,\nactivity('LKP_Target_Count').output.firstRow.CNT\n),\n'PASS',\n'FAIL'\n)",
														"type": "Expression"
													},
													"type": "String"
												},
												"TARGET_COUNT": {
													"value": {
														"value": "@activity('LKP_Target_Count').output.firstRow.CNT",
														"type": "Expression"
													},
													"type": "Int32"
												},
												"TC_ID": {
													"value": {
														"value": "@item().TC_ID",
														"type": "Expression"
													},
													"type": "String"
												},
												"VALIDATION_TYPE": {
													"value": {
														"value": "@item().VALIDATION_TYPE",
														"type": "Expression"
													},
													"type": "String"
												}
											}
										},
										"linkedServiceName": {
											"referenceName": "SqlServer1_Target",
											"type": "LinkedServiceReference"
										}
									}
								]
							}
						}
					]
				}
			}
		],
		"parameters": {
			"p_TC_ID": {
				"type": "string",
				"defaultValue": "ALL"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-06-26T13:27:06Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}