{
	"name": "PL_ETL_Validation_Framework",
	"properties": {
		"activities": [
			{
				"name": "Lookup_ETL_config",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": {
							"value": "SELECT *\nFROM ETL_CONFIG\nWHERE IS_ACTIVE = 'Y'\nAND (\n      '@{pipeline().parameters.p_TC_ID}' = 'ALL'\n      OR TC_ID = '@{pipeline().parameters.p_TC_ID}'\n);",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "SqlServerTable1",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ForEach1_Validate_Tables",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Lookup_ETL_config",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Lookup_ETL_config').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "LKP_Source_Count",
							"type": "Lookup",
							"dependsOn": [],
